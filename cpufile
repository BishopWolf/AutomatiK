${image img/cpu2.png -p 0,0 -s 30x30}
${offset 35}${font DejaVu Sans:size=12}${color Tan1}INFORMATION PROCESSEURS ${color}${hr 2}
${font}${color}${execi 1000 cat /proc/cpuinfo | grep 'model name' | sed -e 's/model name.*: //'| uniq}
${color lightgrey}Température  DIE ${texeci 10 sensors | grep Tdie | awk '{ print $2}'}
${color lightgrey}Température  CTL ${texeci 10 sensors | grep Tctl | awk '{ print $2}'}
${color lightgrey}CPU Power ${texeci 10 sensors | grep SVI2_P_Core | awk '{ print $2}'} W
