double_buffer yes
update_interval 2
background yes

own_window yes
own_window_type normal
own_window_hints undecorated,below,sticky,skip_taskbar,skip_pager
xinerama_head 1
own_window_class conky-semi
out_to_x yes
out_to_wayland no

use_xft yes
xftfont DejaVu Sans:size=10

cpu_avg_samples 2
net_avg_samples 2
maximum_width 320

draw_shades no
draw_outline no
draw_borders no
draw_graph_borders no
stippled_borders 1
border_width 0

default_color white
default_shade_color white
default_outline_color 000000

alignment top_right
use_spacer left
no_buffers yes
uppercase no

color0 white
color2 white
color3 1793d0

pad_percents 2
top_name_width 14
minimum_size 320 100

gap_x 380
gap_y 298

TEXT
${image img/earth_network.png -p 0,0 -s 30x30}
${offset 35}${font DejaVu Sans:size=12}${color Tan1}PERIPHERIQUE RESEAU ${color}${hr 2}${font}
Adresse IP: ${texeci 10000 wget -q -O - checkip.dyndns.org|sed -e 's/.*Current IP Address: //' -e 's/<.*$//'}

${if_match "${addr docker0}"!="No Address"}${goto 14}Interface: ${color3}docker0${color}${goto 160}IP locale:${addr docker0}
${goto 14}${color1}Envoi: ${color3}${upspeed docker0}${color1}${alignr}${goto 180}${color1}Réception:${color1} ${color3}${downspeed docker0}${color}
${goto 14}${color1}Envoyé:${color1} ${color2}${totalup docker0}${color1}${alignr}${goto 180}${color1}Reçu:${color}${color2}${totaldown docker0}${color1}
${goto 14}${upspeedgraph docker0  50,140 000000 FF0000}${goto 180}${downspeedgraph docker0 50,140 000000 00FF00}
${voffset -5}${hr 1}
${endif}${if_match "${addr eno1}"!="No Address"}${goto 14}Interface: ${color3}eno1${color}${goto 160}IP locale:${addr eno1}
${goto 14}${color1}Envoi: ${color3}${upspeed eno1}${color1}${alignr}${goto 180}${color1}Réception:${color1} ${color3}${downspeed eno1}${color}
${goto 14}${color1}Envoyé:${color1} ${color2}${totalup eno1}${color1}${alignr}${goto 180}${color1}Reçu:${color}${color2}${totaldown eno1}${color1}
${goto 14}${upspeedgraph eno1  50,140 000000 FF0000}${goto 180}${downspeedgraph eno1 50,140 000000 00FF00}
${voffset -5}${hr 1}
${endif}