double_buffer yes
update_interval 2
background yes

own_window yes
own_window_type normal
own_window_hints undecorated,below,sticky,skip_taskbar,skip_pager
xinerama_head 1
own_window_class conky-semi
out_to_x yes
out_to_wayland no

use_xft yes
xftfont DejaVu Sans:size=10

cpu_avg_samples 2
net_avg_samples 2
maximum_width 320

draw_shades no
draw_outline no
draw_borders no
draw_graph_borders no
stippled_borders 1
border_width 0

default_color white
default_shade_color white
default_outline_color 000000

alignment top_right
use_spacer left
no_buffers yes
uppercase no

color0 white
color2 white
color3 1793d0

pad_percents 2
top_name_width 14
minimum_size 320 100

