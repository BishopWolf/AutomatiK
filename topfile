double_buffer yes
update_interval 2
background yes

own_window yes
own_window_type normal
own_window_hints undecorated,below,sticky,skip_taskbar,skip_pager
xinerama_head 0
own_window_class conky-semi
out_to_x yes
out_to_wayland no

use_xft yes
xftfont DejaVu Sans:size=10

cpu_avg_samples 2
net_avg_samples 2
maximum_width 320

draw_shades no
draw_outline no
draw_borders no
draw_graph_borders no
stippled_borders 1
border_width 0

default_color white
default_shade_color white
default_outline_color 000000

alignment top_right
use_spacer left
no_buffers yes
uppercase no

color0 white
color2 white
color3 1793d0

pad_percents 2
top_name_width 14
minimum_size 320 100
gap_x 380
gap_y 50

TEXT
${image img/gearwheels.png -p 0,0 -s 30x30}
${offset 35}${font DejaVu Sans:size=12}${color Tan1}TACHES ET PROCESSUS ${color}${hr 2}${font}
${offset 5}${color}Charge: ${loadavg 1}
#${running_processes} ${running_threads} ${processes}
${hr 2}${font}
${color lightgrey}${font DejaVu Sans Mono:size=9}${goto 5}PROCESS${goto 140}CPU${goto 192}MEMOIRE${goto 300}PID
${hr 1}
${goto 5}${top name 1}${goto 120}${top cpu 1}%${goto 192}${top mem_res 1}${goto 270}${top pid 1}
${goto 5}${top name 2}${goto 120}${top cpu 2}%${goto 192}${top mem_res 2}${goto 270}${top pid 2}
${goto 5}${top name 3}${goto 120}${top cpu 3}%${goto 192}${top mem_res 3}${goto 270}${top pid 3}
${goto 5}${top name 4}${goto 120}${top cpu 4}%${goto 192}${top mem_res 4}${goto 270}${top pid 4}
${goto 5}${top name 5}${goto 120}${top cpu 5}%${goto 192}${top mem_res 5}${goto 270}${top pid 5}${font}